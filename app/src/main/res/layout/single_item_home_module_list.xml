<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card1"
    android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="4dp"
    android:elevation="1dp"
    android:gravity="center"
    android:orientation="vertical"
    app:ignore="NamespaceTypo"

    card_view:cardCornerRadius="14dp"
    card_view:cardElevation="1dp">

<!--    card_view:cardBackgroundColor="@android:color/transparent"-->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:visibility="gone"
                android:id="@+id/iv_circle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:layout_centerInParent="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/circle_border"
                app:backgroundTint="@color/light_color2" />

            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerInParent="true"
                android:padding="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_circle"
                app:layout_constraintEnd_toEndOf="@+id/iv_circle"
                app:layout_constraintStart_toStartOf="@+id/iv_circle"
                app:layout_constraintTop_toTopOf="@+id/iv_circle"
                app:srcCompat="@drawable/ic_doctor1" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:text="Title"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="13dp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/tv_title_ban"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="0dp"
            android:fontFamily="@font/solaiman_lipi"
            android:gravity="center"
            android:text="টাইটেল"
            android:textAlignment="center"
            android:textColor="@color/colorPrimary"
            android:textSize="12dp" />

    </LinearLayout>



    <LinearLayout
        android:visibility="visible"
        android:id="@+id/linear_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:background="@drawable/rounded_corner_home_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp"
            android:paddingBottom="0dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="130dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="left"
                    android:text="Mymensingh \nDivision"
                    android:textColor="@color/black"
                    android:textSize="13dp" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/solaiman_lipi"
                    android:gravity="left"
                    android:text="All services"
                    android:textColor="@color/red_700"
                    android:textSize="9dp"
                    android:visibility="visible" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView

                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/ic_next2"
                        android:visibility="visible"
                        android:backgroundTint="@color/green_600" />

                    <ImageView

                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="5dp"
                        android:padding="0dp"
                        android:background="@drawable/mymensingh_map" />

                </RelativeLayout>



            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:visibility="visible"
        android:id="@+id/linear_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:background="@drawable/rounded_corner_home_card2"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp"
            android:paddingBottom="0dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="130dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="left"
                    android:text="Doctor \nAppointment"
                    android:textColor="@color/black"
                    android:textSize="13dp" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/solaiman_lipi"
                    android:gravity="left"
                    android:text="Easy appointment"
                    android:textColor="@color/red_700"
                    android:textSize="9dp"
                    android:visibility="visible" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView

                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/ic_next2"
                        android:backgroundTint="@color/yellow_700"
                        android:visibility="visible" />

                    <ImageView

                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="5dp"
                        android:padding="0dp"
                        android:background="@drawable/ic_doctor1" />

                </RelativeLayout>



            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:visibility="visible"
        android:id="@+id/linear_item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:background="@drawable/rounded_corner_home_card3"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="0dp"
            android:paddingBottom="0dp"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="130dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:foreground="?android:attr/selectableItemBackground">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="0dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="left"
                    android:text="Home \nPathology"
                    android:textColor="@color/black"
                    android:textSize="13dp" />

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="@font/solaiman_lipi"
                    android:gravity="left"
                    android:text="Home collection option"
                    android:textColor="@color/red_700"
                    android:textSize="9dp"
                    android:visibility="visible" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView

                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/ic_next2"
                        android:backgroundTint="@color/blue_500"
                        android:visibility="visible" />

                    <ImageView

                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="5dp"
                        android:padding="0dp"
                        android:background="@drawable/patholopgy" />

                </RelativeLayout>



            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    </LinearLayout>


</androidx.cardview.widget.CardView>