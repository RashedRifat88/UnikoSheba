<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="2dp"
    android:background="@color/white"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="marquee"
                android:fontFamily="@font/solaiman_lipi"
                android:marqueeRepeatLimit="marquee_forever"
                android:padding="3dp"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text=" আপনাকে স্বাগতম !!"
                android:textColor="@color/black"
                android:textSize="13dp"
                android:textStyle="normal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>



        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="90dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="6dp"
                    app:iss_auto_cycle="true"
                    app:iss_corner_radius="20"
                    app:iss_delay="0"
                    app:iss_period="2000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginBottom="10dp"
                    android:minHeight="30dp"
                    android:orientation="horizontal"
                    android:visibility="gone">


                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginTop="0dp"
                        android:layout_marginRight="0dp"
                        android:background="@drawable/rounded_corner8"
                        android:drawableLeft="@drawable/ic_icon_search"
                        android:drawablePadding="17dp"
                        android:drawableTint="@color/grey_500"
                        android:fontFamily="@font/poppins_light"
                        android:hint="search .."
                        android:inputType="text"
                        android:paddingStart="20dp"
                        android:paddingLeft="2dp"
                        android:paddingTop="8dp"
                        android:paddingRight="2dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/colorPrimary"
                        android:textColorHint="@color/grey_500"
                        android:textSize="14dp" />

                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="60dp"
                    android:cacheColorHint="#ffffff"
                    android:visibility="visible" />

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/image_slider2"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="6dp"
                    app:iss_auto_cycle="true"
                    app:iss_corner_radius="20"
                    app:iss_delay="0"
                    app:iss_period="2000" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>



    </LinearLayout>


</RelativeLayout>